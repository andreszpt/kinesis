# ============================================================================
# 1. LLM Provider Configuration (Multi-provider supported)
# ============================================================================
# Options: "auto", "opencode-go", "anthropic", "openai", "google"
LLM_PROVIDER=opencode-go

# Optional explicit model override (leave blank for provider default):
# - OpenCode Go default: kimi-k3 (also supports glm-5.3, glm-5.3-flash, gpt-6-luna,
#   claude-haiku-5-5, qwen3.8-max, deepseek-v4.1-flash, mimo-v2.6-pro, etc.)
# - Anthropic default:   claude-sonnet-4-20250514
# - OpenAI default:      gpt-4o
# - Google default:      gemini-2.5-pro
LLM_MODEL=kimi-k3
# Optional temperature (leave blank; deprecated on newer Anthropic/reasoning models):
LLM_TEMPERATURE=

# OpenCode Go API Key (from https://opencode.ai/console):
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go

# Alternative direct provider API keys (if not using OpenCode Go):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ============================================================================
# 2. Intervals.icu API Configuration
# ============================================================================
# Generate in intervals.icu -> Settings -> Developer Settings -> API Key
INTERVALS_ICU_API_KEY=

# Use "0" to automatically resolve the authenticated athlete, or your "i12345" ID
INTERVALS_ICU_ATHLETE_ID=0

# ============================================================================
# 3. Optional NCBI / PubMed Configuration (for higher rate limits)
# ============================================================================
NCBI_API_KEY=
NCBI_EMAIL=kinesis-agent@example.com
